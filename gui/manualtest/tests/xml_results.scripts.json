        "label": "Wait for the dialog to close"
      },
      {
        "do": "click",
        "name": "File",
        "role": "menu item",
        "label": "Open the File menu again"
      },
      {
        "do": "click",
        "name": "Open Project File",
        "role": "menu item",
        "label": "Choose File > Open Project File"
      },
      {
        "do": "wait",
        "name": "Select Project File",
        "timeout": 10,
        "label": "Wait for the project file dialog"
      },
      {
        "do": "settext",
