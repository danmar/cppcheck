{
  "title": "Analysis and recheck",
  "tests": [
    {
      "id": "te65b1fa8",
      "name": "Reanalyze all files",
      "steps": [
        "Open the project file {project:basic-project}/basic.cppcheck (File menu) and wait until the analysis is done.",
        "Edit the files {project:basic-project}/src/a.c and {project:basic-project}/src/b.c so they only contain \";\".",
        "Click Reanalyze all files and wait until the analysis is done."
      ],
      "expected": "When the analysis is done there should be no results for a.c and b.c",
      "script": [
        {
          "label": "Open the File menu",
          "do": "click",
          "name": "File",
          "role": "menu item"
        },
        {
          "label": "Choose Open Project File",
          "do": "click",
          "name": "Open Project File",
          "role": "menu item"
        },
        {
          "label": "Enter the project file path",
          "do": "settext",
          "name": "File name:",
          "role": "text",
          "value": "{project:basic-project}/basic.cppcheck"
        },
        {
          "label": "Confirm the file dialog",
          "do": "key",
          "keys": [
            "Return"
          ]
        },
        {
          "label": "Wait until the first analysis shows results for a.c",
          "expect": "visible",
          "name": "src/a.c",
          "role": "table cell",
          "timeout": 30
        },
        {
          "label": "Results for b.c are shown too",
          "expect": "visible",
          "name": "src/b.c",
          "role": "table cell"
        },
        {
          "label": "Edit a.c so it only contains ;",
          "do": "write",
          "path": "{project:basic-project}/src/a.c",
          "content": ";"
        },
        {
          "label": "Edit b.c so it only contains ;",
          "do": "write",
          "path": "{project:basic-project}/src/b.c",
          "content": ";"
        },
        {
          "label": "Click Reanalyze all files",
          "do": "click",
          "name": "Reanalyze all files",
          "role": "button"
        },
        {
          "label": "Wait until the analysis is done (No errors found dialog)",
          "expect": "visible",
          "name": "No errors found",
          "role": "label",
          "timeout": 30
        },
        {
          "label": "Close the dialog",
          "do": "click",
          "name": "OK",
          "role": "button"
        },
        {
          "label": "No results for a.c",
          "expect": "gone",
          "name": "src/a.c",
          "role": "table cell"
        },
        {
          "label": "No results for b.c",
          "expect": "gone",
          "name": "src/b.c",
          "role": "table cell"
        }
      ],
      "projects": [
        "basic-project"
      ],
      "script_for": "0198ba992317"
    },
    {
      "id": "tc707b85b",
      "name": "Recheck a changed file",
      "ticket": "#14893",
      "steps": [
        "Start the application with no project loaded.",
        "Open the project file {project:recheck}/p.cppcheck and wait until the analysis is done. The results show a nullPointer error in a.c and an arrayIndexOutOfBounds error in b.c.",
        "Change a.c: copy {project:recheck}/a_v2.c over {project:recheck}/a.c (a_v2.c has an uninitvar error instead).",
        "Right click on the file a.c in the results and click Recheck."
      ],
      "expected": "The results for a.c are refreshed: the nullPointer error is gone and the uninitvar error from the changed a.c is shown. The results for b.c are still shown, unchanged (arrayIndexOutOfBounds in b.c).",
      "script": [
        {
          "do": "wait",
          "name": "Cppcheck",
          "role": "frame",
          "timeout": 20,
          "label": "Application started with no project"
        },
        {
          "do": "click",
          "name": "Open Project File",
          "role": "button",
          "label": "Open the project file dialog"
        },
        {
          "do": "settext",
          "name": "File name:",
          "role": "text",
          "value": "{project:recheck}/p.cppcheck",
          "label": "Enter the path of p.cppcheck"
        },
        {
          "do": "key",
          "keys": [
            "Return"
          ],
          "label": "Open the project"
        },
        {
          "expect": "visible",
          "name": "b.c",
          "role": "table cell",
          "timeout": 30,
          "label": "Analysis done, b.c in the results"
        },
        {
          "expect": "visible",
          "name": "a.c",
          "role": "table cell",
          "timeout": 30,
          "label": "a.c in the results"
        },
        {
          "do": "sleep",
          "seconds": 3,
          "label": "Let the analysis finish"
        },
        {
          "do": "copy",
          "from": "{project:recheck}/a_v2.c",
          "to": "{project:recheck}/a.c",
          "label": "Change a.c by copying a_v2.c over it"
        },
        {
          "do": "rightclick",
          "name": "a.c",
          "role": "table cell",
          "nth": 0,
          "label": "Right click on a.c in the results"
        },
        {
          "expect": "ocr",
          "contains": "Recheck",
          "label": "Context menu shows Recheck"
        },
        {
          "do": "key",
          "keys": [
            "Down",
            "Return"
          ],
          "label": "Click Recheck"
        },
        {
          "do": "sleep",
          "seconds": 4,
          "label": "Wait for the recheck"
        },
        {
          "do": "click",
          "name": "b.c",
          "role": "table cell",
          "nth": 0,
          "label": "Select the b.c row"
        },
        {
          "do": "key",
          "keys": [
            "Right",
            "Down",
            "Down",
            "Down",
            "Right"
          ],
          "label": "Expand b.c and a.c to show their results"
        },
        {
          "expect": "text",
          "contains": "uninitvar",
          "label": "The uninitvar error of the changed a.c is shown"
        },
        {
          "expect": "text",
          "not_contains": "nullPointer",
          "label": "The nullPointer error is gone"
        },
        {
          "expect": "text",
          "contains": "arrayIndexOutOfBounds",
          "label": "The arrayIndexOutOfBounds error in b.c is still shown"
        }
      ],
      "projects": [
        "recheck"
      ],
      "script_for": "07cf713caa82"
    },
    {
      "id": "tc550387d",
      "name": "Recheck a header file",
      "steps": [
        "Start the application with no project loaded.",
        "Open the project file {project:basic-project}/basic.cppcheck (File menu) and wait until the analysis is done.",
        "Right click on the file util.h in the results and click Recheck. Wait until the analysis is done."
      ],
      "expected": "The context menu of util.h has a Recheck entry. The analysis is run again for the files that include util.h and the nullPointer error in util.h is shown again afterwards.",
      "script": [
        {
          "do": "click",
          "name": "File",
          "role": "menu item",
          "label": "Open the File menu"
        },
        {
          "do": "click",
          "name": "Open Project File",
          "role": "menu item",
          "label": "Choose Open Project File"
        },
        {
          "do": "settext",
          "name": "File name:",
          "role": "text",
          "value": "{project:basic-project}/basic.cppcheck",
          "label": "Enter the project file path"
        },
        {
          "do": "key",
          "keys": [
            "Return"
          ],
          "label": "Confirm the file dialog"
        },
        {
          "expect": "visible",
          "name": "include/util.h",
          "role": "table cell",
          "timeout": 30,
          "label": "Analysis is done and util.h is in the results"
        },
        {
          "expect": "visible",
          "name": "src/b.c",
          "role": "table cell",
          "timeout": 30,
          "label": "Analysis finished for all files"
        },
        {
          "do": "rightclick",
          "name": "include/util.h",
          "role": "table cell",
          "label": "Right click on util.h in the results"
        },
        {
          "do": "sleep",
          "seconds": 1,
          "label": "Wait for the context menu"
        },
        {
          "do": "key",
          "keys": [
            "Down",
            "Return"
          ],
          "label": "Click the Recheck entry of the context menu"
        },
        {
          "expect": "text",
          "contains": "Checking /tmp",
          "timeout": 30,
          "label": "The analysis was run again"
        },
        {
          "expect": "text",
          "contains": "src/a.c ...",
          "timeout": 30,
          "label": "The file that includes util.h is checked again"
        },
        {
          "do": "sleep",
          "seconds": 3,
          "label": "Wait until the analysis is done"
        },
        {
          "do": "click",
          "name": "include/util.h",
          "role": "table cell",
          "mouse": true,
          "label": "Select util.h with the mouse so it has focus"
        },
        {
          "do": "key",
          "keys": [
            "Right"
          ],
          "label": "Expand util.h"
        },
        {
          "expect": "visible",
          "name": "nullPointer",
          "role": "table cell",
          "timeout": 10,
          "label": "The nullPointer error in util.h is shown again"
        },
        {
          "expect": "visible",
          "name": "Null pointer dereference",
          "role": "table cell",
          "timeout": 5,
          "label": "The nullPointer message is shown"
        }
      ],
      "projects": [
        "basic-project"
      ],
      "script_for": "e29e38750a0d"
    },
    {
      "id": "ta6f3b40b",
      "name": "Analyze a broken source file",
      "steps": [
        "Start the application with no project loaded.",
        "Open the project file {project:syntax-error}/{case}.cppcheck and wait until the analysis is done. It checks {case}.c, a broken or unusual source file, and ok.c, which has a nullPointer error."
      ],
      "expected": "The analysis finishes and the application does not crash. The nullPointer error in ok.c is shown.",
      "script": [
        {
          "label": "Start the application with no project loaded",
          "expect": "visible",
          "name": "Cppcheck",
          "role": "frame"
        },
        {
          "label": "Open the project file",
          "do": "click",
          "name": "Open Project File",
          "role": "button"
        },
        {
          "label": "Wait for the Select Project File dialog",
          "do": "wait",
          "name": "Select Project File",
          "timeout": 10
        },
        {
          "label": "Enter the project file {case}.cppcheck",
          "do": "settext",
          "name": "File name:",
          "role": "text",
          "value": "{project:syntax-error}/{case}.cppcheck"
        },
        {
          "label": "Confirm the file dialog",
          "do": "key",
          "keys": [
            "Return"
          ]
        },
        {
          "label": "The project is loaded",
          "expect": "visible",
          "name": "Project: {case}.cppcheck",
          "role": "frame",
          "timeout": 15
        },
        {
          "label": "Wait until the analysis is done (ok.c is checked)",
          "expect": "text",
          "contains": "Checking ok.c",
          "timeout": 60
        },
        {
          "label": "Give the analysis time to finish",
          "do": "sleep",
          "seconds": 3
        },
        {
          "label": "The analysis finishes: Stop analysis is disabled again",
          "expect": "state",
          "name": "Stop analysis",
          "role": "button",
          "not_state": "enabled",
          "timeout": 60
        },
        {
          "label": "The analysis finishes: Reanalyze all files is enabled again",
          "expect": "state",
          "name": "Reanalyze all files",
          "role": "button",
          "state": "enabled",
          "timeout": 30
        },
        {
          "label": "The broken source file {case}.c was analyzed",
          "expect": "text",
          "contains": "Checking {case}.c"
        },
        {
          "label": "The nullPointer error in ok.c is shown (ok.c has a result row)",
          "expect": "visible",
          "name": "ok.c",
          "role": "table cell"
        },
        {
          "label": "The application does not crash",
          "expect": "alive"
        }
      ],
      "projects": [
        "syntax-error"
      ],
      "matrix": {
        "case": [
          "braces",
          "empty",
          "binary",
          "latin1",
          "long_line",
          "unclosed_nesting"
        ]
      },
      "script_for": "ed80d3198afb"
    }
  ]
}
