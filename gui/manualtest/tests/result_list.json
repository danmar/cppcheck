          "not_state": "checked",
          "label": "Cppcheck changed to unchecked after first click"
        },
        {
          "expect": "state",
          "name": "Clang",
          "role": "check box",
          "not_state": "checked",
          "label": "Clang changed to unchecked after first click"
        },
        {
          "do": "click",
          "name": "Show errors",
          "role": "check box",
          "label": "Click Error a second time"
        },
        {
          "do": "click",
          "name": "Show warnings",
          "role": "check box",
          "label": "Click Warning a second time"
        },
        {
          "do": "click",
          "name": "Show style warnings",
          "role": "check box",
          "label": "Click Style a second time"
        },
        {
          "do": "click",
          "name": "Show portability",
          "role": "check box",
          "label": "Click Portability a second time"
        },
        {
          "do": "click",
          "name": "Show performance warnings",
          "role": "check box",
          "label": "Click Performance a second time"
        },
        {
          "do": "click",
