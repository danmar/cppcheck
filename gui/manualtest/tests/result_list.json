    {
      "name": "Context menu of a file entry",
      "projects": [
        "basic-project"
      ],
      "steps": [
        "Start the application with no project loaded.",
        "Open the project file {project:basic-project}/basic.cppcheck (File menu) and wait until the analysis is done.",
        "Right click on the file a.c in the results (not on one of its errors)."
      ],
      "expected": "The context menu of the file entry has the entries Recheck and Open containing folder. It has none of the entries Hide, Hide all with ID or Suppress selected id, they only apply to a single error.",
      "id": "t4c027507",
      "script": [
        {
          "do": "click",
          "name": "File",
          "role": "menu item",
          "label": "Open the File menu"
        },
        {
          "do": "click",
          "name": "Open Project File...",
          "role": "menu item",
          "label": "Choose Open Project File from the File menu"
        },
        {
          "do": "wait",
          "name": "Select Project File",
          "role": "dialog",
          "label": "Wait for the file dialog"
        },
        {
          "do": "settext",
          "name": "File name:",
          "role": "text",
          "value": "{project:basic-project}/basic.cppcheck",
          "label": "Enter the path of basic.cppcheck"
        },
        {
          "do": "key",
          "keys": [
            "Return"
          ],
          "label": "Confirm the file dialog"
        },
        {
          "do": "wait",
          "name": "src/b.c",
          "role": "table cell",
          "timeout": 60,
          "label": "Wait until the analysis is done and results are shown"
        },
        {
          "do": "wait",
          "name": "Select Project File",
          "gone": true,
          "label": "File dialog is closed"
        },
        {
          "do": "rightclick",
          "name": "src/a.c",
          "role": "table cell",
          "label": "Right click on the file a.c in the results"
        },
        {
          "expect": "ocr",
          "contains": "Recheck",
          "label": "Context menu has Recheck"
        },
        {
          "expect": "ocr",
          "contains": "Open containing folder",
          "label": "Context menu has Open containing folder"
        },
        {
          "expect": "ocr",
          "not_contains": "Hide",
          "label": "Context menu has no Hide entries"
        },
        {
          "expect": "ocr",
          "not_contains": "Suppress selected id",
          "label": "Context menu has no Suppress selected id"
        }
      ],
      "script_for": "e2522fcc1afb"
    },
    {
      "name": "Hide one error",
      "projects": [
        "basic-project"
      ],
      "steps": [
        "Start the application with no project loaded.",
        "Open the project file {project:basic-project}/basic.cppcheck (File menu) and wait until the analysis is done.",
        "Expand a.c in the results.",
        "Right click on the first nullPointer error (line 6) and click Hide."
      ],
      "expected": "That error is gone. The other errors are still shown, including the second nullPointer error in a.c (line 12).",
      "id": "taacc3841",
      "script": [
        {
          "do": "click",
          "name": "File",
          "role": "menu item",
          "label": "Open the File menu"
        },
        {
          "do": "click",
          "name": "Open Project File",
          "role": "menu item",
          "label": "Choose Open Project File"
        },
        {
          "do": "settext",
          "name": "File name:",
          "role": "text",
          "value": "{project:basic-project}/basic.cppcheck",
          "label": "Enter the project file path"
        },
        {
          "do": "key",
          "keys": [
            "Return"
          ],
          "label": "Open the project file"
        },
        {
          "expect": "visible",
          "name": "src/a.c",
          "role": "table cell",
          "timeout": 30,
          "label": "Analysis is done and results show a.c"
        },
        {
          "do": "focus",
          "name": "src/a.c",
          "role": "table cell",
          "label": "Focus the a.c row"
        },
        {
          "do": "key",
          "keys": [
            "Right"
          ],
          "label": "Expand a.c in the results"
        },
        {
          "expect": "visible",
          "name": "Null pointer dereference: p",
          "role": "table cell",
          "label": "First nullPointer error (line 6) is shown"
        },
        {
          "do": "rightclick",
          "name": "Null pointer dereference: p",
          "role": "table cell",
          "label": "Right click on the first nullPointer error"
        },
        {
          "do": "key",
          "keys": [
            "Down",
            "Down",
            "Down",
            "Return"
          ],
          "label": "Click Hide (Hide 1 result(s)) in the context menu"
        },
        {
          "expect": "gone",
          "name": "Null pointer dereference: p",
          "label": "The hidden error is gone"
        },
        {
          "expect": "visible",
          "name": "Null pointer dereference: q",
          "role": "table cell",
          "label": "Second nullPointer error (line 12) is still shown"
        },
        {
          "expect": "visible",
          "name": "Variable 'p' can be declared as pointer to const",
          "role": "table cell",
          "label": "Other errors are still shown (line 5)"
        },
        {
          "expect": "visible",
          "name": "Variable 'q' can be declared as pointer to const",
          "role": "table cell",
          "label": "Other errors are still shown (line 11)"
        }
      ],
      "script_for": "f2771f5855a0"
    },
