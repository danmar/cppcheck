        {
          "expect": "state",
          "name": "Show portability",
          "role": "check box",
          "not_state": "checked",
          "label": "Portability changed to unchecked after first click"
        },
        {
          "expect": "state",
          "name": "Show performance warnings",
          "role": "check box",
          "not_state": "checked",
          "label": "Performance changed to unchecked after first click"
        },
        {
          "expect": "state",
          "name": "Show information",
          "role": "check box",
