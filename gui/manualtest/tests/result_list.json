    {
      "name": "Severity buttons toggle",
      "steps": [
        "Start the application with no project loaded.",
        "Click each of the toolbar buttons Error, Warning, Style, Portability, Performance, Information, Cppcheck and Clang once.",
        "Click each of them once more."
      ],
      "expected": "Every button can be clicked and changes between checked and unchecked. After the second click all buttons are in the state they had at the start.",
      "id": "t852206f1",
      "script": [
        {
          "do": "click",
          "name": "Show errors",
          "role": "check box",
          "label": "Click Error once"
        },
        {
          "do": "click",
          "name": "Show warnings",
          "role": "check box",
          "label": "Click Warning once"
        },
        {
          "do": "click",
          "name": "Show style warnings",
          "role": "check box",
          "label": "Click Style once"
        },
        {
          "do": "click",
          "name": "Show portability",
          "role": "check box",
          "label": "Click Portability once"
        },
        {
          "do": "click",
          "name": "Show performance warnings",
          "role": "check box",
          "label": "Click Performance once"
        },
        {
          "do": "click",
          "name": "Show information",
          "role": "check box",
          "label": "Click Information once"
        },
        {
          "do": "click",
          "name": "Cppcheck",
          "role": "check box",
          "label": "Click Cppcheck once"
        },
        {
          "do": "click",
          "name": "Clang",
          "role": "check box",
          "label": "Click Clang once"
        },
        {
          "expect": "state",
          "name": "Show errors",
          "role": "check box",
          "not_state": "checked",
          "label": "Error changed to unchecked after first click"
        },
        {
          "expect": "state",
          "name": "Show warnings",
          "role": "check box",
          "not_state": "checked",
          "label": "Warning changed to unchecked after first click"
        },
        {
          "expect": "state",
